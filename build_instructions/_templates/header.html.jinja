<header class="cytkit-header">
  <div class="cytkit-header-inner">

    <!-- Logo, links to home page -->
    <a href="{{ root }}" class="cytkit-brand">
      <img src="{{ root }}assets/web_logo.jpg" alt="{{ title }}" class="cytkit-logo" style="padding-right:20px"> Cytkit Build Instructions
    </a>

    <!-- Hamburger (mobile only) -->
    <button class="cytkit-menu-toggle" type="button"
            aria-label="Toggle navigation" aria-expanded="false"
            aria-controls="cytkit-nav">
      <span></span><span></span><span></span>
    </button>

    <!-- Right-aligned links -->
    <nav id="cytkit-nav" class="cytkit-nav">
      <a href="https://cytkit.com">Cytkit Home</a>
      <a href="https://github.com/Cytkit/Cytkit" target="_blank" rel="noopener">GitHub</a>
      <a href="https://cytkit.com/contact">Contact</a>
    </nav>

  </div>
</header>

<style>
  /* --- Neutralise GitBuilding's default header wrapper --- */
  header.site-header {
    padding: 0 !important;
    margin: 0 !important;
  }
  header.site-header > .wrapper.header-wrapper {
    display: block !important;      /* undo any centring flex */
    width: 100% !important;
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* --- Our header --- */
  .cytkit-header {
    width: 100%;
    background: #fff;
    border-bottom: 1px solid #e0e0e0;
    position: relative;
    z-index: 0;
    box-sizing: border-box;
    font-size: 14pt;
    font-weight: bolder;
  }
  .cytkit-header-inner {
    width: 100%;
    margin: 0 auto;
    padding: 0.5rem 1rem;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;   /* logo left, nav right */
    gap: 1rem;
  }

  .cytkit-brand { display: flex; align-items: center; text-decoration: none; flex: 0 0 auto; }
  .cytkit-logo  { height: 40px; width: auto; display: block; }

  .cytkit-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: 0 0 auto;                  /* don't stretch */
    margin-left: auto;               /* belt-and-braces: push to right */
  }
  .cytkit-nav a {
    text-decoration: none;
    color: #333;
    white-space: nowrap;
  }
  .cytkit-nav a:hover { color: #f1502f; }

  .cytkit-menu-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 0.5rem;
    cursor: pointer;
    flex-direction: column;
    gap: 4px;
  }
  .cytkit-menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #333;
    border-radius: 2px;
  }

  @media (max-width: 767.98px) {
    .cytkit-menu-toggle { display: flex; margin-left: auto; }
    .cytkit-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      border-bottom: 1px solid #e0e0e0;
      flex-direction: column;
      align-items: stretch;
      padding: 0.75rem 1rem;
      gap: 0.75rem;
      margin-left: 0;
    }
    .cytkit-nav.cytkit-nav-open { display: flex; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var toggle = document.querySelector('.cytkit-menu-toggle');
    var nav    = document.getElementById('cytkit-nav');
    if (!toggle || !nav) return;
    toggle.addEventListener('click', function () {
      var open = nav.classList.toggle('cytkit-nav-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });
</script>